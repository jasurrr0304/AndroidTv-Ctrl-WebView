<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra del cursor -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#60000000" />
            <size
                android:width="44dp"
                android:height="44dp" />
        </shape>
    </item>
    <!-- Círculo principal del cursor -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#E0FFFFFF" />
            <stroke
                android:width="4dp"
                android:color="#FF4CAF50" />
            <size
                android:width="40dp"
                android:height="40dp" />
        </shape>
    </item>
    <!-- Punto central -->
    <item
        android:top="16dp"
        android:left="16dp"
        android:right="16dp"
        android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#FF4CAF50" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000">

    <!-- Panel lateral para URLs -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1a1a1a"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sonia Tv - Menú"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- Botones de control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnReload"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Recargar"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:background="@drawable/button_bg"
                android:padding="8dp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleCursor"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Cursor ON"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:background="@drawable/button_bg"
                android:padding="8dp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleUserAgent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="TV"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:background="@drawable/button_bg"
                android:padding="8dp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnResetZoom"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Zoom 100%"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:background="@drawable/button_bg"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Lista de URLs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/urlRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants"
            android:layout_marginBottom="12dp" />

        <!-- Campo para ingresar URL -->
        <EditText
            android:id="@+id/urlEditText"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:hint="Ingrese URL"
            android:textColorHint="#888888"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:background="@drawable/edittext_bg"
            android:padding="8dp"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:nextFocusDown="@id/btnAddUrl" />

        <Button
            android:id="@+id/btnAddUrl"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Agregar URL"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:background="@drawable/button_bg"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Área principal con WebView -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignParentTop="true"
            android:progressTint="#4CAF50"
            android:visibility="gone" />

        <!-- WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/progressBar" />

        <!-- Cursor virtual para navegación con control remoto -->
        <View
            android:id="@+id/cursor"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/cursor_shape"
            android:elevation="10dp"
            android:visibility="visible" />

    </RelativeLayout>

</LinearLayout>
